<?xml version="1.0" encoding="utf-8"?>
<!-- Sin copias en la nube ni transferencia entre dispositivos: la clave de cifrado vive en el Keystore
     de cada móvil y no es restaurable, así que una copia del archivo cifrado sería ilegible.
     Para cambiar de móvil, el usuario usa "Exportar mis datos". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
